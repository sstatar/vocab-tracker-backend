generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String?
  password     String
  vocabularies Vocabulary[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  dailyGoal      Int       @default(20)
  currentStreak  Int       @default(0)
  lastActiveDate DateTime?

  dailyProgresses DailyProgress[]
}

model Vocabulary {
  id           String   @id @default(uuid())
  word         String
  meaning      String
  partOfSpeech String
  example      String?
  status       Status   @default(LEARNING)
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([userId])
}

model DailyProgress {
  id            String   @id @default(uuid())
  userId        String
  date          DateTime
  reviewedCount Int      @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
}

enum Status {
  LEARNING
  NEEDS_REVIEW
  MASTERED
}
